# 复制这个文件为 .env 就能覆盖默认配置（不复制也能跑，用的是代码里的默认值）

# 统一响应外壳里，成功时 code 的值（前端拦截器按这个判断成功；改成 0 也可以，不用动业务代码）
API_SUCCESS_CODE=200

# 数据库（默认 SQLite，文件生成在 backend/risk.db）
DATABASE_URL=sqlite+aiosqlite:///./risk.db

# token 签名密钥：上线前必须换成随机长字符串
SECRET_KEY=loan-mvp-dev-secret-key-please-change
# token 有效期（秒），默认 7 天
TOKEN_TTL_SECONDS=604800

# 允许跨域的前端地址（JSON 数组写法）。开发期放开所有来源，上线换成 ["http://你的域名"]
CORS_ORIGINS=["*"]

# True = 控制台打印 SQL；调试用，平时可以设成 false
DEBUG=true
