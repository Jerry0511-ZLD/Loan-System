<?xml version="1.0" encoding="utf-8"?>
<!-- 颜色表。界面里不要直接写 #FFFFFF，统一引用这里的名字，改主题色只要改一处。 -->
<resources>
    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF000000</color>

    <!-- 主题色：银行/金融类 App 常用的蓝色 -->
    <color name="primary">#FF1565C0</color>
    <color name="primary_dark">#FF0D47A1</color>
    <color name="primary_container">#FFE3F2FD</color>

    <color name="background">#FFF4F6F8</color>
    <color name="text_primary">#FF212121</color>
    <color name="text_secondary">#FF757575</color>
    <color name="divider">#FFE0E0E0</color>

    <!-- 申请状态对应的颜色：待审批=橙，已通过=绿，已拒绝=红 -->
    <color name="status_pending">#FFEF6C00</color>
    <color name="status_approved">#FF2E7D32</color>
    <color name="status_rejected">#FFC62828</color>

    <!-- 进度步骤：未完成的步骤用灰色 -->
    <color name="step_inactive">#FFBDBDBD</color>

    <!-- 第二阶段占位区块的配色 -->
    <color name="placeholder_bg">#FFFFF8E1</color>
    <color name="placeholder_stroke">#FFFFB300</color>
</resources>